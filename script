---------------------------------------------------------------------
-- Hotkey loop (edge-detected, chat-safe)
---------------------------------------------------------------------
local chatOpen = false
local enterWas, escWas, slashWas = false, false, false

local function textBoxFocused()
    local uis = getUIS()
    if not uis then return false, false end
    local ok, box = pcall(function() return uis:GetFocusedTextBox() end)
    if ok then return box ~= nil, true end
    return false, false
end

local wasDown = false
task.spawn(function()
    while alive() do
        local active = isrbxactive()

        local enter = active and iskeypressed(VK_ENTER)
        local esc = active and iskeypressed(VK_ESC)
        local slash = active and iskeypressed(VK_SLASH)
        if slash and not slashWas and not chatOpen then
            chatOpen = true
        elseif enter and not enterWas then
            chatOpen = not chatOpen
        end
        if esc and not escWas then chatOpen = false end
        enterWas, escWas, slashWas = enter, esc, slash

        local focused, supported = textBoxFocused()
        local typing = (supported and focused) or (not supported and chatOpen)

        local down = active and iskeypressed(VK_U)
        if UI.GetValue("cling_ctrl") then
            down = down and iskeypressed(VK_LCTRL)
        end

        if down and not wasDown and not typing then
            UI.SetValue("cling_enabled", not UI.GetValue("cling_enabled"))
        end
        wasDown = down
        task.wait()
    end
end)

---------------------------------------------------------------------
-- FAST PATH: one CFrame read + one CFrame write per update
---------------------------------------------------------------------
local function readTarget()
    local c = tRootC.CFrame
    local p = c.Position
    local lv = c.LookVector
    return p.X, p.Y, p.Z, lv.X, lv.Z
end

local function writeGoal()
    myRootC.CFrame = goalCF
end

local lastStep = 0
local function followStep()
    if not locked or not tRootC or not myRootC then return end
    local now = tick()
    if now - lastStep < 0.002 then return end
    lastStep = now

    local ok, px, py, pz, lx, lz = pcall(readTarget)
    if not ok or not isNum(px) or not isNum(py) or not isNum(pz) then return end -- slow loop revalidates

    if isNum(lx) and isNum(lz) then
        local l = math.sqrt(lx * lx + lz * lz)
        if l > 0.05 then lx, lz = lx / l, lz / l else lx, lz = nil, nil end
    else
        lx, lz = nil, nil
    end

    updateTracker(tTracker, px, pz, lx, lz, now)

    local fx, fz, src = resolveFacing(tTracker, S.mode)
    if S.corr ~= 0 then fx, fz = rot(fx, fz, math.rad(S.corr)) end
    dbgSrc, dbgFx, dbgFz = src, fx, fz

    -- lead the target's movement so you land where they will be
    local lead = S.leadMs / 1000
    if S.usePing then lead = lead + S.ping / 1000 end
    local ox, oz = 0, 0
    local sp = tTracker.speed
    if lead > 0 and sp > 2 and sp < 60 then
        ox, oz = tTracker.vx * lead, tTracker.vz * lead
        local m = math.sqrt(ox * ox + oz * oz)
        if m > 5 then ox, oz = ox * 5 / m, oz * 5 / m end
    end

    local gx = px + ox - fx * S.back
    local gy = py + S.up
    local gz = pz + oz - fz * S.back

    local goal = buildCFrame(gx, gy, gz, fx, fz)
    if not goal then return end
    goalCF = goal

    local okW, err = pcall(writeGoal)
    if not okW then
        if not writeEverOK then
            warn("[Cling] CFrame write failed: " .. tostring(err))
            unlock("CFrame writes aren't supported here, see console")
        end
        return -- otherwise a stale part after respawn; slow loop will refresh it
    end
    writeEverOK = true

    if writeChecks < 8 then
        writeChecks = writeChecks + 1
        local rok, cur = pcall(function() return myRootC.Position end)
        if rok and cur then
            local d = dist3(cur, Vector3.new(gx, gy, gz))
            if d and d > 8 then writeFails = writeFails + 1 end
        end
        if writeChecks == 8 and writeFails == 8 then
            unlock("Write had no effect (position unchanged). Needs memory offsets.")
        end
    end
end

-- driver 1: plain loop (known to work)
task.spawn(function()
    while alive() do
        followStep()
        task.wait()
    end
end)

-- driver 2: RenderStepped, if Matcha lets us connect (extra update source)
do
    local conn
    local ok = pcall(function()
        local rs = game:GetService("RunService")
        conn = rs.RenderStepped:Connect(function()
            if not alive() then
                if conn then pcall(function() conn:Disconnect() end) end
                return
            end
            followStep()
        end)
    end)
    if not ok then print("[Cling] RenderStepped unavailable, using loop only") end
end

---------------------------------------------------------------------
-- SLOW LOOP (~30 Hz): enable/disable, target pick, validity, calibration
---------------------------------------------------------------------
task.spawn(function()
    while alive() do
        if not ensurePlayers() then
            reportWaiting()
            if locked and waitStart and (tick() - waitStart) > 5 then unlock() end
            task.wait(0.5)
        else
            clearWaiting()
            refreshSettings()
            local now = tick()
            local enabled = UI.GetValue("cling_enabled")

            if enabled and not locked then
                local myRoot, myHum = getChar(LP)
                if not myRoot then
                    unlock("Your character isn't ready")
                else
                    local _, _, hasMouse = getCursor()
                    local p = pickUnderCursor(UI.GetValue("cling_radius"))
                    local pRoot = p and getChar(p)
                    if not p or not pRoot then
                        unlock(hasMouse and "No player under cursor" or "No player near screen center (cursor read unavailable)")
                    else
                        target = p
                        myRootC, tRootC = myRoot, pRoot
                        writeChecks, writeFails = 0, 0
                        tTracker = newTracker()
                        lockMovement(myHum)
                        locked = true
                        notify("Clinging to " .. p.Name, "Cling", 2)
                    end
                end
            elseif not enabled and locked then
                unlock("Cling off")
            end

            if locked then
                local myRoot = getChar(LP)
                local tRoot = getChar(target)
                if not myRoot then
                    unlock("Your character is gone, cling stopped")
                elseif not tRoot then
                    unlock("Target died or left, cling stopped")
                else
                    myRootC, tRootC = myRoot, tRoot -- refresh after respawns

                    if UI.GetValue("cling_debug") and (now - lastDebug) > 1 then
                        lastDebug = now
                        local cok, th, R = getCalib()
                        print(string.format("[Cling] src=%s face=(%.2f,%.2f) calibOK=%s theta=%d conf=%.2f samples=%.0f speed=%.1f",
                            dbgSrc, dbgFx, dbgFz, tostring(cok), math.floor(math.deg(th) + 0.5), R, calib.w, tTracker.speed))
                    end
                end
            else
                -- idle: learn the rotation error from your own walking
                local myRoot = getChar(LP)
                if myRoot then
                    local ok, c = pcall(function() return myRoot.CFrame end)
                    if ok and c then
                        local okp, p, lv = pcall(function() return c.Position, c.LookVector end)
                        if okp and p and lv and isNum(p.X) and isNum(lv.X) and isNum(lv.Z) then
                            local l = math.sqrt(lv.X * lv.X + lv.Z * lv.Z)
                            if l > 0.05 then
                                updateTracker(lpTracker, p.X, p.Z, lv.X / l, lv.Z / l, now)
                            end
                        end
                    end
                else
                    lpTracker = newTracker()
                end
            end

            task.wait(0.03)
        end
    end
    restoreMovement()
end)

notify("Cling v3.2 loaded. Walk around a bit, aim at a player, press Ctrl+U.", "Cling", 4)
