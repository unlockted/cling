-- Cling To Back v3.2 (Matcha) - closer + low-latency follow
-- Toggle: Left Ctrl + U (or the checkbox in the "Cling" tab)
-- Unload: _G.__ClingSession = nil
-- Re-running replaces any previous copy automatically.

local SESSION = {}
_G.__ClingSession = SESSION
local function alive() return _G.__ClingSession == SESSION end

local VK_U = 0x55
local VK_ENTER, VK_ESC, VK_SLASH, VK_LCTRL = 0x0D, 0x1B, 0xBF, 0xA2

local function isNum(x) return type(x) == "number" end
local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end

---------------------------------------------------------------------
-- Players / LocalPlayer lookup (cached, with grace period)
---------------------------------------------------------------------
local Players, LP
local lastGood = 0
local GRACE = 10

local lookups = {
    function() return game:GetService("Players") end,
    function() return game.Players end,
    function() return game:FindFirstChild("Players") end,
    function() return game:FindFirstChildOfClass("Players") end,
}

local function resolvePlayers()
    local log = {}
    for i, fn in ipairs(lookups) do
        local ok, v = pcall(fn)
        if ok and v then return v, "" end
        log[#log + 1] = "m" .. i .. "=" .. (ok and "nil" or tostring(v))
    end
    return nil, table.concat(log, " | ")
end

local function ensurePlayers()
    if Players and LP then
        local ok, name = pcall(function() return LP.Name end)
        if ok and name then
            lastGood = tick()
            return true
        end
    end
    local svc = resolvePlayers()
    if svc then
        local ok, lp = pcall(function() return svc.LocalPlayer end)
        if ok and lp then
            Players, LP = svc, lp
            lastGood = tick()
            return true
        end
    end
    if Players and LP and (tick() - lastGood) < GRACE then
        return true
    end
    return false
end

local waitStart = nil
local lastWaitReport = 0
local notifiedWaiting = false
local function reportWaiting()
    local now = tick()
    if not waitStart then waitStart = now end
    if now - lastWaitReport < 5 then return end
    lastWaitReport = now
    local _, log = resolvePlayers()
    print("[Cling] waiting for Players/LocalPlayer. " .. (log ~= "" and log or "Players found, LocalPlayer not ready"))
    if not notifiedWaiting then
        notifiedWaiting = true
        notify("Waiting for game to load...", "Cling", 2)
    end
end

local function clearWaiting()
    waitStart = nil
    notifiedWaiting = false
end

local function getUIS()
    local ok, svc = pcall(function() return game:GetService("UserInputService") end)
    if ok and svc then return svc end
    return nil
end

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
local function dist2(ax, ay, bx, by)
    if not (isNum(ax) and isNum(ay) and isNum(bx) and isNum(by)) then return nil end
    local dx, dy = ax - bx, ay - by
    return math.sqrt(dx * dx + dy * dy)
end

local function dist3(a, b)
    local ax, ay, az, bx, by, bz = a.X, a.Y, a.Z, b.X, b.Y, b.Z
    if not (isNum(ax) and isNum(ay) and isNum(az) and isNum(bx) and isNum(by) and isNum(bz)) then return nil end
    local dx, dy, dz = ax - bx, ay - by, az - bz
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function rot(x, z, th)
    local c, s = math.cos(th), math.sin(th)
    return x * c - z * s, x * s + z * c
end

local function getChar(player)
    if not player then return nil end
    local okC, char = pcall(function() return player.Character end)
    if not okC or not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return nil end
    local okH, health = pcall(function() return hum.Health end)
    if okH and isNum(health) and health <= 0 then return nil end
    return hrp, hum
end

local function getCursor()
    local uis = getUIS()
    if uis then
        local ok, pos = pcall(function() return uis:GetMouseLocation() end)
        if ok and pos and isNum(pos.X) and isNum(pos.Y) then return pos.X, pos.Y, true end
    end
    local ok2, vp = pcall(function() return workspace.CurrentCamera.ViewportSize end)
    if ok2 and vp and isNum(vp.X) and isNum(vp.Y) then return vp.X / 2, vp.Y / 2, false end
    return 960, 540, false
end

local function pickUnderCursor(radius)
    radius = isNum(radius) and radius or 250
    local cx, cy = getCursor()
    local best, bestDist = nil, radius
    local okL, list = pcall(function() return Players:GetPlayers() end)
    if not okL or not list then return nil end
    for _, p in ipairs(list) do
        if p ~= LP then
            local root = getChar(p)
            if root then
                local okP, pos = pcall(function() return root.Position end)
                if okP and pos then
                    local screenPos, onScreen = WorldToScreen(pos)
                    if onScreen and screenPos then
                        local d = dist2(screenPos.X, screenPos.Y, cx, cy)
                        if d and d < bestDist then best, bestDist = p, d end
                    end
                end
            end
        end
    end
    return best
end

---------------------------------------------------------------------
-- Settings cache (refreshed ~30x/sec so the fast path never touches UI)
---------------------------------------------------------------------
local S = { back = 1.0, up = 0, corr = 0, mode = 1, leadMs = 40, usePing = false, ping = 0 }

local function sourceMode(v)
    if v == 2 or v == "Raw look direction" then return 2 end
    if v == 3 or v == "Movement direction" then return 3 end
    return 1
end

local function refreshSettings()
    local v = UI.GetValue("cling_offset"); if isNum(v) then S.back = v end
    v = UI.GetValue("cling_height"); if isNum(v) then S.up = v end
    v = UI.GetValue("cling_angle"); if isNum(v) then S.corr = v end
    v = UI.GetValue("cling_lead"); if isNum(v) then S.leadMs = v end
    S.usePing = UI.GetValue("cling_ping") == true
    S.mode = sourceMode(UI.GetValue("cling_source"))
    if S.usePing then
        local ok, p = pcall(GetPingValue)
        if ok and isNum(p) then S.ping = p end
    end
end

---------------------------------------------------------------------
-- Rotation tracking + auto-calibration
---------------------------------------------------------------------
local calib = { c = 0, s = 0, w = 0 }
local WINDOW = 0.15

local function newTracker()
    return { hist = {}, mx = nil, mz = nil, moving = false, lastMx = nil, lastMz = nil,
             lx = nil, lz = nil, vx = 0, vz = 0, speed = 0 }
end

local function updateTracker(tr, px, pz, lx, lz, now)
    local h = tr.hist
    h[#h + 1] = { t = now, x = px, z = pz }
    while #h > 1 and (now - h[2].t) > WINDOW do table.remove(h, 1) end

    local first = h[1]
    local dx, dz = px - first.x, pz - first.z
    local len = math.sqrt(dx * dx + dz * dz)
    local age = now - first.t

    tr.moving = false
    tr.vx, tr.vz, tr.speed = 0, 0, 0
    if age > 0.05 then
        tr.vx, tr.vz = dx / age, dz / age
        tr.speed = len / age
    end
    if age > 0.1 and len > 0.6 and tr.speed > 4 then
        tr.mx, tr.mz = dx / len, dz / len
        tr.lastMx, tr.lastMz = tr.mx, tr.mz
        tr.moving = true
    end

    tr.lx, tr.lz = lx, lz

    -- learn the rotation error while the character is walking
    if tr.moving and lx then
        local dot = lx * tr.mx + lz * tr.mz
        local cross = lx * tr.mz - lz * tr.mx
        calib.c = calib.c * 0.998 + dot
        calib.s = calib.s * 0.998 + cross
        calib.w = calib.w * 0.998 + 1
    end
end

local function getCalib()
    if calib.w < 25 then return false, 0, 0 end
    local R = math.sqrt(calib.c * calib.c + calib.s * calib.s) / calib.w
    if R < 0.7 then return false, 0, R end
    local theta = atan2(calib.s, calib.c)
    local snapped = math.floor(theta / (math.pi / 2) + 0.5) * (math.pi / 2)
    if math.abs(theta - snapped) < math.rad(25) then theta = snapped end
    return true, theta, R
end

local lastFx, lastFz = 0, -1

local function resolveFacing(tr, mode)
    local calibOK, theta = getCalib()
    local fx, fz, src

    if mode == 3 then
        if tr.moving then fx, fz, src = tr.mx, tr.mz, "movement"
        elseif tr.lastMx then fx, fz, src = tr.lastMx, tr.lastMz, "last movement" end
    elseif mode == 2 then
        if tr.lx then fx, fz, src = tr.lx, tr.lz, "raw look" end
    else
        if calibOK and tr.lx then
            fx, fz = rot(tr.lx, tr.lz, theta)
            src = "look+calib"
        elseif tr.moving then
            fx, fz, src = tr.mx, tr.mz, "movement"
        elseif tr.lastMx then
            fx, fz, src = tr.lastMx, tr.lastMz, "last movement"
        elseif tr.lx then
            fx, fz, src = tr.lx, tr.lz, "raw look (uncalibrated)"
        end
    end

    if not fx then fx, fz, src = lastFx, lastFz, "held" end
    lastFx, lastFz = fx, fz
    return fx, fz, src
end

---------------------------------------------------------------------
-- CFrame builder (remembers which method works, so it only probes once)
---------------------------------------------------------------------
local cfMethods = {
    function(gx, gy, gz, fx, fz) return CFrame.new(Vector3.new(gx, gy, gz), Vector3.new(gx + fx, gy, gz + fz)) end,
    function(gx, gy, gz, fx, fz) return CFrame.lookAt(Vector3.new(gx, gy, gz), Vector3.new(gx + fx, gy, gz + fz)) end,
    function(gx, gy, gz, fx, fz) return CFrame.new(gx, gy, gz, -fz, 0, -fx, 0, 1, 0, fx, 0, -fz) end,
    function(gx, gy, gz) return CFrame.new(gx, gy, gz) end,
}
local cfMethod = nil
local warnedPosOnly = false

local function buildCFrame(gx, gy, gz, fx, fz)
    if cfMethod then
        local ok, cf = pcall(cfMethods[cfMethod], gx, gy, gz, fx, fz)
        if ok and cf then return cf end
    end
    for i, fn in ipairs(cfMethods) do
        local ok, cf = pcall(fn, gx, gy, gz, fx, fz)
        if ok and cf then
            cfMethod = i
            if i == #cfMethods and not warnedPosOnly then
                warnedPosOnly = true
                warn("[Cling] orientation CFrame not supported, moving position only")
            end
            return cf
        end
    end
    return nil
end

---------------------------------------------------------------------
-- State
---------------------------------------------------------------------
local locked = false
local target = nil
local saved = nil
local myRootC, tRootC = nil, nil   -- cached root parts for the fast path
local goalCF = nil
local writeChecks, writeFails = 0, 0
local writeEverOK = false
local tTracker = newTracker()
local lpTracker = newTracker()
local lastDebug = 0
local dbgSrc, dbgFx, dbgFz = "-", 0, 0

local function lockMovement(hum)
    saved = { hum = hum, ws = nil, jp = nil, jh = nil }
    pcall(function() saved.ws = hum.WalkSpeed end)
    pcall(function() saved.jp = hum.JumpPower end)
    pcall(function() saved.jh = hum.JumpHeight end)
    local ok = pcall(function() hum.WalkSpeed = 0 end)
    if not ok then warn("[Cling] could not set WalkSpeed") end
    pcall(function() hum.JumpPower = 0 end)
    pcall(function() hum.JumpHeight = 0 end)
end

local function restoreMovement()
    if not saved then return end
    local h = saved.hum
    if saved.ws then pcall(function() h.WalkSpeed = saved.ws end) end
    if saved.jp then pcall(function() h.JumpPower = saved.jp end) end
    if saved.jh then pcall(function() h.JumpHeight = saved.jh end) end
    saved = nil
end

local function unlock(reason)
    if locked then
        locked = false
        restoreMovement()
        target, myRootC, tRootC = nil, nil, nil
        tTracker = newTracker()
        lpTracker = newTracker()
        if reason then notify(reason, "Cling", 2.5) end
    end
    if UI.GetValue("cling_enabled") then UI.SetValue("cling_enabled", false) end
end

